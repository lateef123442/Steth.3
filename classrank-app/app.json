{
  "expo": {
    "name": "Steth",
    "slug": "classrank-app",
    "scheme": "classrank",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "description": "Every department. One leaderboard. Daily quizzes and fair, cross-department rankings for university students.",
    "primaryColor": "#14B8A6",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10162C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.classrank.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Steth does not track you across other apps or websites. This permission (if shown) is a side effect of a bundled SDK's default configuration, not an intentional tracking request.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.classrank.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10162C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-font",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Steth uses your photos so you can choose a profile picture."
        }
      ],
      "@sentry/react-native",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "2cf880bb-d652-4005-bc55-38e76d52e73b"
      }
    },
    "icon": "./assets/icon.png",
    "owner": "ahmedabdullateef12345",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2cf880bb-d652-4005-bc55-38e76d52e73b"
    }
  }
}

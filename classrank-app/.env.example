# Copy this file to .env and fill in your Supabase project values.
# Find these under Project Settings -> API in your Supabase dashboard.
# Both must be prefixed with EXPO_PUBLIC_ so Expo inlines them at build time.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — leave blank to run without crash reporting (e.g. in local dev).
# Get this from sentry.io -> your project -> Settings -> Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# Required only for the "Go Pro" paywall to work. Get these from your
# RevenueCat project (Project Settings -> API Keys) after configuring
# subscription products in App Store Connect / Google Play Console and
# linking them in RevenueCat. Leave blank and the app runs fine — the
# paywall just shows an error state instead of real offerings.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional — leave blank to run without analytics. Get this from your
# PostHog project (Project Settings -> Project API Key). Host defaults to
# PostHog Cloud US; change it if you're self-hosting or on EU Cloud.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
